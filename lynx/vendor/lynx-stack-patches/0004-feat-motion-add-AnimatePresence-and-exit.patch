@@ -0,0 +1,267 @@
+// Copyright 2026 The Lynx Authors. All rights reserved.
+// Licensed under the Apache License Version 2.0 that can be found in the
+// LICENSE file in the root directory of this source tree.
+
+import type { FunctionComponent, ReactNode } from '@lynx-js/react';
+import {
+  Children,
+  Fragment,
+  createContext,
+  createElement,
+  isValidElement,
+  useContext,
+  useEffect,
+  useMemo,
+  useRef,
+  useState,
+} from '@lynx-js/react';
+
+/**
+ * Tracks the Motion components rendered inside one presence child so the
+ * child is released only after every one of them has finished exiting.
+ */
+class PresenceRegistry {
+  private members = new Map<number, boolean>();
+  private exiting = false;
+
+  constructor(private readonly release: () => void) {}
+
+  register(id: number): () => void {
+    this.members.set(id, false);
+    return () => {
+      this.members.delete(id);
+      this.check();
+    };
+  }
+
+  complete(id: number): void {
+    if (this.exiting && this.members.has(id)) {
+      this.members.set(id, true);
+      this.check();
+    }
+  }
+
+  setPresent(isPresent: boolean): void {
+    if (isPresent === !this.exiting) {
+      return;
+    }
+    this.exiting = !isPresent;
+    for (const id of this.members.keys()) {
+      this.members.set(id, false);
+    }
+  }
+
+  check(): void {
+    if (!this.exiting) {
+      return;
+    }
+    for (const done of this.members.values()) {
+      if (!done) {
+        return;
+      }
+    }
+    this.exiting = false;
+    this.release();
+  }
+}
+
+/** @internal */
+export interface PresenceContextValue {
+  readonly isPresent: boolean;
+  /** `false` when the enclosing `AnimatePresence` suppresses first mount. */
+  readonly initial?: false | undefined;
+  /** `AnimatePresence.custom`, used to resolve exit variants. */
+  readonly custom?: unknown;
+  readonly registry: PresenceRegistry;
+}
+
+/** @internal */
+export const PresenceContext = createContext<PresenceContextValue | null>(
+  null,
+);
+
+let nextPresenceMemberId = 0;
+
+/**
+ * Register a Motion component with its presence child.
+ *
+ * @internal
+ */
+export function usePresenceMember(): {
+  presence: PresenceContextValue | null;
+  complete: () => void;
+  initialSuppressed: boolean;
+} {
+  const presence = useContext(PresenceContext);
+  const id = useMemo(() => ++nextPresenceMemberId, []);
+  // A presence child only suppresses the mount animation of the components
+  // it renders first, so capture the flag once.
+  const initialSuppressed = useRef(presence?.initial === false).current;
+  const registry = presence?.registry;
+  useEffect(() => registry?.register(id), [registry]);
+  return {
+    presence,
+    complete: () => registry?.complete(id),
+    initialSuppressed,
+  };
+}
+
+interface PresenceChildProps {
+  children: ReactNode;
+  isPresent: boolean;
+  initial: false | undefined;
+  custom: unknown;
+  onExitComplete: () => void;
+}
+
+const PresenceChild: FunctionComponent<PresenceChildProps> = ({
+  children,
+  isPresent,
+  initial,
+  custom,
+  onExitComplete,
+}) => {
+  const releaseRef = useRef(onExitComplete);
+  releaseRef.current = onExitComplete;
+  const registry = useMemo(
+    () => new PresenceRegistry(() => releaseRef.current()),
+    [],
+  );
+  registry.setPresent(isPresent);
+  const value = useMemo<PresenceContextValue>(
+    () => ({ isPresent, initial, custom, registry }),
+    [isPresent, initial, custom, registry],
+  );
+  // A child without Motion components, or whose components have nothing to
+  // animate, is released once the exit has been rendered.
+  useEffect(() => {
+    if (!isPresent) {
+      registry.check();
+    }
+  }, [isPresent, registry]);
+  return createElement(PresenceContext.Provider, { value, children });
+};
+
+type PresenceKey = string | number;
+
+interface PresenceItem {
+  key: PresenceKey;
+  element: ReactNode;
+}
+
+function presenceItems(children: ReactNode): PresenceItem[] {
+  const items: PresenceItem[] = [];
+  Children.toArray(children as never).forEach((child, index) => {
+    if (isValidElement(child)) {
+      const key = (child as { key?: PresenceKey | null }).key;
+      items.push({ key: key ?? `__presence_${index}`, element: child });
+    }
+  });
+  return items;
+}
+
+/** Props accepted by {@link AnimatePresence}. */
+export interface AnimatePresenceProps {
+  children?: ReactNode;
+  /** Set to `false` to skip the mount animation of the first children. */
+  initial?: boolean;
+  /** Value passed to exit variants instead of each component's `custom`. */
+  custom?: unknown;
+  /** Called once every exiting child has been removed. */
+  onExitComplete?: () => void;
+  /**
+   * `'sync'` renders entering and exiting children together; `'wait'`
+   * renders an entering child only after exiting children are removed.
+   */
+  mode?: 'sync' | 'wait';
+}
+
+/**
+ * Keep direct children mounted after React removes them until their `exit`
+ * animations complete. Children must have stable, unique `key`s.
+ *
+ * @public
+ */
+export const AnimatePresence: FunctionComponent<AnimatePresenceProps> = ({
+  children,
+  initial = true,
+  custom,
+  onExitComplete,
+  mode = 'sync',
+}) => {
+  const [, setGeneration] = useState(0);
+  const renderedRef = useRef<PresenceItem[]>([]);
+  const exitingRef = useRef(new Set<PresenceKey>());
+  const isInitialRenderRef = useRef(true);
+  useEffect(() => {
+    isInitialRenderRef.current = false;
+  }, []);
+  const onExitCompleteRef = useRef(onExitComplete);
+  onExitCompleteRef.current = onExitComplete;
+
+  const present = presenceItems(children);
+  const presentKeys = new Set(present.map(item => item.key));
+  const exiting = exitingRef.current;
+  const previous = renderedRef.current;
+  for (const item of previous) {
+    if (!presentKeys.has(item.key)) {
+      exiting.add(item.key);
+    }
+  }
+  for (const key of presentKeys) {
+    exiting.delete(key);
+  }
+
+  // Present children in their new order, with each exiting child kept after
+  // the sibling it previously followed.
+  const next: PresenceItem[] = [...present];
+  previous.forEach((item, index) => {
+    if (!exiting.has(item.key)) {
+      return;
+    }
+    let insertAt = 0;
+    for (let prior = index - 1; prior >= 0; prior--) {
+      const position = next.findIndex(entry =>
+        entry.key === previous[prior]!.key
+      );
+      if (position !== -1) {
+        insertAt = position + 1;
+        break;
+      }
+    }
+    next.splice(insertAt, 0, item);
+  });
+  const previouslyRendered = new Set(previous.map(item => item.key));
+  const rendered = mode === 'wait' && exiting.size > 0
+    ? next.filter(item =>
+      exiting.has(item.key) || previouslyRendered.has(item.key)
+    )
+    : next;
+  renderedRef.current = rendered;
+
+  const release = (key: PresenceKey) => {
+    if (!exitingRef.current.delete(key)) {
+      return;
+    }
+    renderedRef.current = renderedRef.current.filter(item => item.key !== key);
+    setGeneration(generation => generation + 1);
+    if (exitingRef.current.size === 0) {
+      onExitCompleteRef.current?.();
+    }
+  };
+
+  return createElement(
+    Fragment,
+    null,
+    ...rendered.map(item =>
+      createElement(PresenceChild, {
+        key: item.key,
+        isPresent: !exiting.has(item.key),
+        initial: !initial && isInitialRenderRef.current ? false : undefined,
+        custom,
+        onExitComplete: () => release(item.key),
+        children: item.element,
+      })
+    ),
+  );
+};
