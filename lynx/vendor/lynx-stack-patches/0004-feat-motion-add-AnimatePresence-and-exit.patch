+import { beforeEach, describe, expect, test, vi } from 'vitest';
+
+import { useState } from '@lynx-js/react';
+import { act, fireEvent, render } from '@lynx-js/react/testing-library';
+
+import { AnimatePresence, motion } from '../src/index.js';
+import type { MotionVariants } from '../src/declarative/types.js';
+import { ElementCompt } from '../src/polyfill/element.js';
+
+// The testing bridge does not deliver a `runOnBackground` call made after
+// the originating main-thread event returns, so release after an exit
+// animation completes is covered by the dual-renderer harness. These tests
+// cover presence state, exit targets, and synchronous release.
+const wait = (ms: number) =>
+  act(async () => {
+    await new Promise(resolve => setTimeout(resolve, ms));
+  });
+
+describe('AnimatePresence', () => {
+  beforeEach(() => {
+    globalThis.SystemInfo = { platform: 'web' } as typeof SystemInfo;
+    globalThis.NodeList ??= class NodeList {} as typeof NodeList;
+    globalThis.SVGElement ??= class SVGElement {} as typeof SVGElement;
+    globalThis.Element = ElementCompt as unknown as typeof Element;
+    globalThis.HTMLElement = ElementCompt as unknown as typeof HTMLElement;
+    globalThis.EventTarget = ElementCompt as unknown as typeof EventTarget;
+  });
+
+  test('suppresses the initial animation if initial is false', async () => {
+    const { getByTestId } = render(
+      <AnimatePresence initial={false}>
+        <motion.view
+          data-testid='box'
+          initial={{ x: 0 }}
+          animate={{ x: 100 }}
+          exit={{ opacity: 0 }}
+        />
+      </AnimatePresence>,
+      { enableMainThread: true, enableBackgroundThread: true },
+    );
+
+    expect(getByTestId('box').getAttribute('style')).toContain(
+      'translateX(100px)',
+    );
+    await wait(50);
+    expect(getByTestId('box').getAttribute('style')).toContain(
+      'translateX(100px)',
+    );
+  });
+
+  test('animates a component out before removing it', async () => {
+    const onExitComplete = vi.fn();
+    function App() {
+      const [visible, setVisible] = useState(true);
+      return (
+        <view>
+          <AnimatePresence onExitComplete={onExitComplete}>
+            {visible && (
+              <motion.view
+                key='box'
+                data-testid='box'
+                style={{ opacity: 1 }}
+                exit={{ opacity: 0 }}
+                transition={{ duration: 0.2, ease: 'linear' }}
+              />
+            )}
+          </AnimatePresence>
+          <view data-testid='toggle' bindtap={() => setVisible(false)} />
+        </view>
+      );
+    }
+    const { getByTestId, queryByTestId } = render(<App />, {
+      enableMainThread: true,
+      enableBackgroundThread: true,
+    });
+
+    fireEvent.tap(getByTestId('toggle'));
+    await wait(80);
+    const style = queryByTestId('box')?.getAttribute('style') ?? '';
+    const opacity = Number(/opacity: ([\d.]+)/.exec(style)?.[1]);
+    expect(opacity).toBeGreaterThan(0);
+    expect(opacity).toBeLessThan(1);
+    expect(onExitComplete).not.toHaveBeenCalled();
+  });
+
+  test('immediately removes a child without an exit animation', async () => {
+    function App() {
+      const [index, setIndex] = useState(0);
+      return (
+        <view>
+          <AnimatePresence mode='wait'>
+            <motion.view
+              key={index}
+              data-testid={`box-${index}`}
+              animate={{ opacity: 1 }}
+              transition={{ duration: 0.5 }}
+            />
+          </AnimatePresence>
+          <view data-testid='next' bindtap={() => setIndex(i => i + 1)} />
+        </view>
+      );
+    }
+    const { getByTestId, queryByTestId } = render(<App />, {
+      enableMainThread: true,
+      enableBackgroundThread: true,
+    });
+
+    fireEvent.tap(getByTestId('next'));
+    await wait(30);
+    expect(queryByTestId('box-0')).toBeNull();
+    expect(queryByTestId('box-1')).not.toBeNull();
+  });
+
+  test('renders one child at a time in wait mode', async () => {
+    function App() {
+      const [index, setIndex] = useState(0);
+      return (
+        <view data-testid='root'>
+          <AnimatePresence mode='wait'>
+            <motion.view
+              key={index}
+              data-testid={`box-${index}`}
+              animate={{ opacity: 1 }}
+              exit={{ opacity: 0 }}
+              transition={{ duration: 0.1 }}
+            />
+          </AnimatePresence>
+          <view data-testid='next' bindtap={() => setIndex(i => i + 1)} />
+        </view>
+      );
+    }
+    const { getByTestId, queryByTestId } = render(<App />, {
+      enableMainThread: true,
+      enableBackgroundThread: true,
+    });
+
+    await wait(20);
+    fireEvent.tap(getByTestId('next'));
+    await wait(30);
+    expect(queryByTestId('box-0')).not.toBeNull();
+    expect(queryByTestId('box-1')).toBeNull();
+  });
+
+  test('animates a component back in if re-added before it exits', async () => {
+    function App() {
+      const [visible, setVisible] = useState(true);
+      return (
+        <view>
+          <AnimatePresence>
+            {visible && (
+              <motion.view
+                key='box'
+                data-testid='box'
+                animate={{ opacity: 1 }}
+                exit={{ opacity: 0 }}
+                transition={{ duration: 0.1 }}
+              />
+            )}
+          </AnimatePresence>
+          <view data-testid='toggle' bindtap={() => setVisible(v => !v)} />
+        </view>
+      );
+    }
+    const { getByTestId } = render(<App />, {
+      enableMainThread: true,
+      enableBackgroundThread: true,
+    });
+
+    await wait(20);
+    fireEvent.tap(getByTestId('toggle'));
+    await wait(40);
+    fireEvent.tap(getByTestId('toggle'));
+    await wait(200);
+    expect(getByTestId('box').getAttribute('style')).toContain('opacity: 1');
+  });
+
+  test('resolves exit variants with AnimatePresence custom', async () => {
+    const variants: MotionVariants = {
+      enter: { x: 0, transition: { type: false } },
+      exit: (i: unknown) => ({
+        x: Number(i) * 100,
+        transition: { duration: 0.3, ease: () => 1 },
+      }),
+    };
+    function App() {
+      const [visible, setVisible] = useState(true);
+      return (
+        <view>
+          <AnimatePresence custom={2}>
+            {visible && (
+              <motion.view
+                key='box'
+                data-testid='box'
+                custom={1}
+                variants={variants}
+                initial='exit'
+                animate='enter'
+                exit='exit'
+              />
+            )}
+          </AnimatePresence>
+          <view data-testid='toggle' bindtap={() => setVisible(false)} />
+        </view>
+      );
+    }
+    const { getByTestId } = render(<App />, {
+      enableMainThread: true,
+      enableBackgroundThread: true,
+    });
+
+    await wait(20);
+    fireEvent.tap(getByTestId('toggle'));
+    await wait(60);
+    expect(getByTestId('box').getAttribute('style')).toContain(
+      'translateX(200px)',
+    );
+  });
+
+  test('propagates exit through variants', async () => {
+    const variants: MotionVariants = {
+      enter: { opacity: 1, transition: { type: false } },
+      exit: { opacity: 0, transition: { duration: 0.3, ease: () => 1 } },
+    };
+    function App() {
+      const [visible, setVisible] = useState(true);
+      return (
+        <view>
+          <AnimatePresence>
+            {visible && (
+              <motion.view
+                key='parent'
+                initial='enter'
+                animate='enter'
+                exit='exit'
+                variants={variants}
+              >
+                <motion.view variants={variants}>
+                  <motion.view data-testid='leaf' variants={variants} />
+                </motion.view>
+              </motion.view>
+            )}
+          </AnimatePresence>
+          <view data-testid='toggle' bindtap={() => setVisible(false)} />
+        </view>
+      );
+    }
+    const { getByTestId } = render(<App />, {
+      enableMainThread: true,
+      enableBackgroundThread: true,
+    });
+
+    await wait(20);
+    fireEvent.tap(getByTestId('toggle'));
+    await wait(60);
+    expect(getByTestId('leaf').getAttribute('style')).toContain('opacity: 0');
+  });
+});
