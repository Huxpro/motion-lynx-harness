@@ -0,0 +1,138 @@
+// Copyright 2026 The Lynx Authors. All rights reserved.
+// Licensed under the Apache License Version 2.0 that can be found in the
+// LICENSE file in the root directory of this source tree.
+
+/**
+ * Transitions cross from the background runtime to the main thread as JSON.
+ * Two Motion values do not survive that trip: `Infinity` becomes `null`, and
+ * easing callbacks are dropped. This module encodes both in the background
+ * and restores them on the main thread.
+ *
+ * Easing callbacks are pure functions of progress, so they are sampled into a
+ * piecewise-linear lookup table, the same technique motion-dom uses when it
+ * hands a JavaScript easing function to WAAPI as CSS `linear()`.
+ */
+
+const SAMPLED_EASE = '__lynxSampledEase';
+const INFINITE_REPEAT = -1;
+const EASE_SAMPLES = 128;
+
+type TransitionRecord = Record<string, unknown>;
+
+interface SampledEase {
+  [SAMPLED_EASE]: number[];
+}
+
+function isRecord(value: unknown): value is TransitionRecord {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function sampleEase(ease: (progress: number) => number): SampledEase {
+  const samples: number[] = [];
+  for (let i = 0; i <= EASE_SAMPLES; i++) {
+    samples.push(ease(i / EASE_SAMPLES));
+  }
+  return { [SAMPLED_EASE]: samples };
+}
+
+function encodeEase(ease: unknown): unknown {
+  if (typeof ease === 'function') {
+    return sampleEase(ease as (progress: number) => number);
+  }
+  if (Array.isArray(ease) && ease.some(item => typeof item === 'function')) {
+    return ease.map(item => encodeEase(item));
+  }
+  return ease;
+}
+
+function encodeRecord(transition: TransitionRecord): TransitionRecord {
+  let encoded: TransitionRecord | undefined;
+  for (const key in transition) {
+    const value = transition[key];
+    let next = value;
+    if (key === 'ease') {
+      next = encodeEase(value);
+    } else if (key === 'repeat' && value === Number.POSITIVE_INFINITY) {
+      next = INFINITE_REPEAT;
+    } else if (isRecord(value)) {
+      // Value-specific transitions (`transition.x`, `transition.default`).
+      next = encodeRecord(value);
+    }
+    if (next !== value) {
+      encoded ??= { ...transition };
+      encoded[key] = next;
+    }
+  }
+  return encoded ?? transition;
+}
+
+/**
+ * Prepare a transition for `runOnMainThread`. Returns the input unchanged when
+ * nothing needs encoding, so memoized transitions keep their identity.
+ *
+ * @internal
+ */
+export function toWorkletTransition<T>(transition: T): T {
+  return isRecord(transition)
+    ? encodeRecord(transition) as T
+    : transition;
+}
+
+function isSampledEase(value: unknown): value is SampledEase {
+  return isRecord(value) && Array.isArray(value[SAMPLED_EASE]);
+}
+
+function decodeEase(ease: unknown): unknown {
+  if (isSampledEase(ease)) {
+    const samples = ease[SAMPLED_EASE];
+    const segments = samples.length - 1;
+    return (progress: number) => {
+      if (progress <= 0) {
+        return samples[0];
+      }
+      if (progress >= 1) {
+        return samples[segments];
+      }
+      const position = progress * segments;
+      const index = Math.floor(position);
+      const from = samples[index]!;
+      return from + (samples[index + 1]! - from) * (position - index);
+    };
+  }
+  if (Array.isArray(ease) && ease.some(item => isSampledEase(item))) {
+    return ease.map(item => decodeEase(item));
+  }
+  return ease;
+}
+
+function decodeRecord(transition: TransitionRecord): TransitionRecord {
+  let decoded: TransitionRecord | undefined;
+  for (const key in transition) {
+    const value = transition[key];
+    let next = value;
+    if (key === 'ease') {
+      next = decodeEase(value);
+    } else if (key === 'repeat' && value === INFINITE_REPEAT) {
+      next = Number.POSITIVE_INFINITY;
+    } else if (isRecord(value)) {
+      next = decodeRecord(value);
+    }
+    if (next !== value) {
+      decoded ??= { ...transition };
+      decoded[key] = next;
+    }
+  }
+  return decoded ?? transition;
+}
+
+/**
+ * Restore a transition encoded by {@link toWorkletTransition} on the main
+ * thread.
+ *
+ * @internal
+ */
+export function fromWorkletTransition<T>(transition: T): T {
+  return isRecord(transition)
+    ? decodeRecord(transition) as T
+    : transition;
+}
