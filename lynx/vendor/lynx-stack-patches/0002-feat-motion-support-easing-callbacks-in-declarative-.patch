+// Copyright 2026 The Lynx Authors. All rights reserved.
+// Licensed under the Apache License Version 2.0 that can be found in the
+// LICENSE file in the root directory of this source tree.
+
+import { describe, expect, test } from 'vitest';
+
+import {
+  fromWorkletTransition,
+  toWorkletTransition,
+} from '../src/declarative/workletTransition.js';
+
+function roundTrip<T>(transition: T): T {
+  return fromWorkletTransition(
+    JSON.parse(JSON.stringify(toWorkletTransition(transition))) as T,
+  );
+}
+
+describe('worklet transitions', () => {
+  test('keep JSON-safe transitions by identity', () => {
+    const transition = { duration: 0.2, ease: [0.4, 0, 0.2, 1] };
+    expect(toWorkletTransition(transition)).toBe(transition);
+    expect(fromWorkletTransition(transition)).toBe(transition);
+  });
+
+  test('preserve infinite repeat at the top level and per value', () => {
+    const decoded = roundTrip({
+      repeat: Number.POSITIVE_INFINITY,
+      x: { repeat: Number.POSITIVE_INFINITY, duration: 1 },
+    });
+    expect(decoded.repeat).toBe(Number.POSITIVE_INFINITY);
+    expect(decoded.x.repeat).toBe(Number.POSITIVE_INFINITY);
+  });
+
+  test('sample easing callbacks into equivalent main-thread functions', () => {
+    const easeIn = (progress: number) => progress * progress;
+    const decoded = roundTrip({
+      ease: easeIn,
+      opacity: { ease: ['linear', easeIn] },
+    });
+    const ease = decoded.ease as unknown as (progress: number) => number;
+    for (const progress of [0, 0.1, 0.33, 0.5, 0.9, 1]) {
+      expect(ease(progress)).toBeCloseTo(easeIn(progress), 4);
+    }
+    const perValue = decoded.opacity.ease as unknown as [
+      string,
+      (progress: number) => number,
+    ];
+    expect(perValue[0]).toBe('linear');
+    expect(perValue[1](0.5)).toBeCloseTo(0.25, 4);
+  });
+
+  test('keep overshooting easing output', () => {
+    const overshoot = (progress: number) =>
+      progress + Math.sin(progress * Math.PI) * 0.5;
+    const ease = roundTrip({ ease: overshoot }).ease as unknown as (
+      progress: number,
+    ) => number;
+    expect(ease(0.5)).toBeCloseTo(1, 3);
+  });
+});
