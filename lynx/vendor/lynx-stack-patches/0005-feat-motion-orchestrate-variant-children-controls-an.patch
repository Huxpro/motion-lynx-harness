+// Copyright 2026 The Lynx Authors. All rights reserved.
+// Licensed under the Apache License Version 2.0 that can be found in the
+// LICENSE file in the root directory of this source tree.
+
+/**
+ * Background mirror of Motion's variant tree.
+ *
+ * On the Web, a parent VisualElement drives its variant children directly.
+ * In Lynx every component animates itself from the main thread, so this tree
+ * only carries what the children need from their parent: their position for
+ * stagger timing, the completion of the parent or of the subtree for `when`
+ * orchestration, and gesture state for gesture variant propagation.
+ */
+
+export type GestureEvent = 'tapStart' | 'tapEnd' | 'hoverStart' | 'hoverEnd';
+
+interface Deferred {
+  promise: Promise<void>;
+  resolve: () => void;
+}
+
+function createDeferred(): Deferred {
+  let resolve!: () => void;
+  const promise = new Promise<void>(done => {
+    resolve = done;
+  });
+  return { promise, resolve };
+}
+
+/** One animation of a node to one resolved definition. */
+export class AnimationSession {
+  private readonly self = createDeferred();
+  private settled = false;
+
+  constructor(
+    readonly key: string,
+    private readonly node: VariantNode,
+  ) {}
+
+  /** Mark this node's own values as finished. */
+  settle(): void {
+    if (!this.settled) {
+      this.settled = true;
+      this.self.resolve();
+    }
+  }
+
+  /** This node's own values have finished. */
+  get selfComplete(): Promise<void> {
+    return this.self.promise;
+  }
+
+  /** This node and every variant descendant have finished. */
+  complete(): Promise<void> {
+    const children = this.node.children;
+    return this.self.promise.then(() =>
+      Promise.all(children.map(child => child.completeCurrent())).then(
+        () => undefined,
+      )
+    );
+  }
+}
+
+export class VariantNode {
+  readonly children: VariantNode[] = [];
+  session: AnimationSession | undefined;
+  private readonly listeners = new Set<(event: GestureEvent) => void>();
+
+  /** Register a variant child. Children keep their mount order. */
+  addChild(child: VariantNode): void {
+    if (!this.children.includes(child)) {
+      this.children.push(child);
+    }
+  }
+
+  removeChild(child: VariantNode): void {
+    const index = this.children.indexOf(child);
+    if (index !== -1) {
+      this.children.splice(index, 1);
+    }
+  }
+
+  /** Start a session for `key` unless one is already running for it. */
+  beginSession(key: string): AnimationSession {
+    if (this.session?.key !== key) {
+      this.session = new AnimationSession(key, this);
+    }
+    return this.session;
+  }
+
+  completeCurrent(): Promise<void> {
+    return this.session ? this.session.complete() : Promise.resolve();
+  }
+
+  /**
+   * Stagger offset for a variant child, as motion-dom's `calcChildStagger`.
+   */
+  stagger(
+    child: VariantNode,
+    delayChildren: unknown,
+    staggerChildren = 0,
+    staggerDirection = 1,
+  ): number {
+    const index = this.children.indexOf(child);
+    if (index === -1) {
+      return 0;
+    }
+    const total = this.children.length;
+    if (typeof delayChildren === 'function') {
+      return (delayChildren as (index: number, total: number) => number)(
+        index,
+        total,
+      );
+    }
+    return staggerDirection === 1
+      ? index * staggerChildren
+      : (total - 1) * staggerChildren - index * staggerChildren;
+  }
+
+  listen(listener: (event: GestureEvent) => void): () => void {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+
+  get hasListeners(): boolean {
+    return this.listeners.size > 0;
+  }
+
+  emit(event: GestureEvent): void {
+    for (const listener of this.listeners) {
+      listener(event);
+    }
