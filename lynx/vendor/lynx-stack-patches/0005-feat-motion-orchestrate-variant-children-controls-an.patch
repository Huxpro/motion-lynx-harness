+// Copyright 2026 The Lynx Authors. All rights reserved.
+// Licensed under the Apache License Version 2.0 that can be found in the
+// LICENSE file in the root directory of this source tree.
+
+import { beforeEach, describe, expect, test } from 'vitest';
+
+import { useEffect } from '@lynx-js/react';
+import { act, fireEvent, render } from '@lynx-js/react/testing-library';
+
+import { motion, stagger, useAnimationControls } from '../src/index.js';
+import type { MotionVariants } from '../src/declarative/types.js';
+import { ElementCompt } from '../src/polyfill/element.js';
+
+const wait = (ms: number) =>
+  act(async () => {
+    await new Promise(resolve => setTimeout(resolve, ms));
+  });
+
+const opacityOf = (element: Element) =>
+  Number(/opacity: ([\d.]+)/.exec(element.getAttribute('style') ?? '')?.[1]);
+
+// Children hold opacity 0 until their stagger delay passes, then jump to 1.
+const childVariants: MotionVariants = {
+  hidden: { opacity: 0 },
+  visible: { opacity: 1, transition: { duration: 0.01 } },
+};
+
+describe('variant orchestration', () => {
+  beforeEach(() => {
+    globalThis.SystemInfo = { platform: 'web' } as typeof SystemInfo;
+    globalThis.NodeList ??= class NodeList {} as typeof NodeList;
+    globalThis.SVGElement ??= class SVGElement {} as typeof SVGElement;
+    globalThis.Element = ElementCompt as unknown as typeof Element;
+    globalThis.HTMLElement = ElementCompt as unknown as typeof HTMLElement;
+    globalThis.EventTarget = ElementCompt as unknown as typeof EventTarget;
+  });
+
+  test('delayChildren: stagger() offsets each variant child', async () => {
+    const { getByTestId } = render(
+      <motion.view
+        initial='hidden'
+        animate='visible'
+        variants={{
+          hidden: {},
+          visible: { transition: { delayChildren: stagger(0.15) } },
+        }}
+      >
+        <motion.view data-testid='a' variants={childVariants} />
+        <motion.view data-testid='b' variants={childVariants} />
+      </motion.view>,
+      { enableMainThread: true, enableBackgroundThread: true },
+    );
+
+    await wait(80);
+    expect(opacityOf(getByTestId('a'))).toBe(1);
+    expect(opacityOf(getByTestId('b'))).toBe(0);
+    await wait(150);
+    expect(opacityOf(getByTestId('b'))).toBe(1);
+  });
+
+  test('staggerChildren offsets each variant child', async () => {
+    const { getByTestId } = render(
+      <motion.view
+        initial='hidden'
+        animate='visible'
+        variants={{
+          hidden: {},
+          visible: { transition: { staggerChildren: 0.15 } },
+        }}
+      >
+        <motion.view data-testid='a' variants={childVariants} />
+        <motion.view data-testid='b' variants={childVariants} />
+      </motion.view>,
+      { enableMainThread: true, enableBackgroundThread: true },
+    );
+
+    await wait(80);
+    expect(opacityOf(getByTestId('a'))).toBe(1);
+    expect(opacityOf(getByTestId('b'))).toBe(0);
+    await wait(150);
+    expect(opacityOf(getByTestId('b'))).toBe(1);
+  });
+
+  test('components without variants are transparent to stagger order', async () => {
+    const { getByTestId } = render(
+      <motion.view
+        initial='hidden'
+        animate='visible'
+        variants={{
+          visible: {
+            transition: { staggerChildren: 0.1, staggerDirection: -1 },
+          },
+        }}
+      >
+        <motion.view>
+          <motion.view />
+          <motion.view data-testid='1' variants={childVariants} />
+          <motion.view data-testid='2' variants={childVariants} />
+        </motion.view>
+        <motion.view>
+          <motion.view data-testid='3' variants={childVariants} />
+          <motion.view data-testid='4' variants={childVariants} />
+        </motion.view>
+      </motion.view>,
+      { enableMainThread: true, enableBackgroundThread: true },
+    );
+
+    // Reverse order: 4 at 0ms, 3 at 100ms, 2 at 200ms, 1 at 300ms.
+    await wait(50);
+    expect(['1', '2', '3', '4'].map(id => opacityOf(getByTestId(id))))
+      .toEqual([0, 0, 0, 1]);
+    await wait(100);
+    expect(['1', '2', '3', '4'].map(id => opacityOf(getByTestId(id))))
+      .toEqual([0, 0, 1, 1]);
+    await wait(200);
+    expect(['1', '2', '3', '4'].map(id => opacityOf(getByTestId(id))))
+      .toEqual([1, 1, 1, 1]);
+  });
+
+  test('afterChildren holds the parent while children animate', async () => {
+    const { getByTestId } = render(
+      <motion.view
+        data-testid='parent'
+        initial={{ opacity: 0 }}
+        animate='visible'
+        variants={{
+          visible: {
+            opacity: 1,
+            transition: { duration: 0.01, when: 'afterChildren' },
+          },
+        }}
+      >
+        <motion.view
+          data-testid='child'
+          initial={{ opacity: 0 }}
+          variants={{
+            visible: { opacity: 1, transition: { duration: 0.01 } },
+          }}
+        />
+      </motion.view>,
+      { enableMainThread: true, enableBackgroundThread: true },
+    );
+
+    await wait(60);
+    expect(opacityOf(getByTestId('child'))).toBe(1);
+    // The parent starts from the children's completion signal, which the
+    // testing bridge does not deliver; the dual-renderer harness covers it.
+    expect(opacityOf(getByTestId('parent'))).toBe(0);
+  });
+});
+
+describe('animation controls', () => {
+  beforeEach(() => {
+    globalThis.SystemInfo = { platform: 'web' } as typeof SystemInfo;
+    globalThis.Element = ElementCompt as unknown as typeof Element;
+    globalThis.HTMLElement = ElementCompt as unknown as typeof HTMLElement;
+    globalThis.EventTarget = ElementCompt as unknown as typeof EventTarget;
+  });
+
+  test('start animates bound components and their variant children', async () => {
+    function App() {
+      const controls = useAnimationControls();
+      useEffect(() => {
+        void controls.start('foo');
+      }, []);
+      return (
+        <motion.view
+          data-testid='parent'
+          animate={controls}
+          variants={{ foo: { x: 100, transition: { duration: 0.01 } } }}
+        >
+          <motion.view
+            data-testid='child'
+            variants={{
+              foo: { opacity: 0.4, transition: { duration: 0.01 } },
+            }}
+          />
+        </motion.view>
+      );
+    }
+    const { getByTestId } = render(<App />, {
+      enableMainThread: true,
+      enableBackgroundThread: true,
+    });
+
+    await wait(80);
+    expect(getByTestId('parent').getAttribute('style')).toContain(
+      'translateX(100px)',
+    );
+    expect(opacityOf(getByTestId('child'))).toBe(0.4);
+  });
+
+  test('set jumps every bound component without animating', async () => {
+    function App() {
+      const controls = useAnimationControls();
+      useEffect(() => {
+        controls.set({ x: 1 });
+      }, []);
+      return (
+        <view>
+          <motion.view data-testid='a' animate={controls} />
+          <motion.view data-testid='b' animate={controls} />
+        </view>
+      );
+    }
+    const { getByTestId } = render(<App />, {
+      enableMainThread: true,
+      enableBackgroundThread: true,
+    });
+
+    await wait(20);
+    for (const id of ['a', 'b']) {
+      expect(getByTestId(id).getAttribute('style')).toContain(
+        'translateX(1px)',
+      );
+    }
+  });
+});
+
+describe('gesture variant propagation', () => {
+  beforeEach(() => {
+    globalThis.SystemInfo = { platform: 'web' } as typeof SystemInfo;
+    globalThis.Element = ElementCompt as unknown as typeof Element;
+    globalThis.HTMLElement = ElementCompt as unknown as typeof HTMLElement;
+    globalThis.EventTarget = ElementCompt as unknown as typeof EventTarget;
+  });
+
+  test('a whileTap label applies and unapplies children', async () => {
+    const { getByTestId } = render(
+      <motion.view data-testid='parent' whileTap='pressed'>
+        <motion.view
+          data-testid='child'
+          style={{ opacity: 0.5 }}
+          variants={{ pressed: { opacity: 1 } }}
+          transition={{ type: false }}
+        />
+      </motion.view>,
+      { enableMainThread: true, enableBackgroundThread: true },
+    );
+
+    await wait(20);
+    expect(opacityOf(getByTestId('child'))).toBe(0.5);
+    fireEvent.touchstart(getByTestId('parent'));
+    await wait(30);
+    expect(opacityOf(getByTestId('child'))).toBe(1);
+    fireEvent.touchend(getByTestId('parent'));
+    await wait(30);
+    expect(opacityOf(getByTestId('child'))).toBe(0.5);
+  });
+});
