+// Copyright 2026 The Lynx Authors. All rights reserved.
+// Licensed under the Apache License Version 2.0 that can be found in the
+// LICENSE file in the root directory of this source tree.
+
+import { useEffect, useMemo } from '@lynx-js/react';
+
+import type { MotionDefinition, MotionTransition } from './types.js';
+
+/** A Motion component bound to controls through `animate={controls}`. */
+export interface AnimationControlsSubscriber {
+  start(
+    definition: MotionDefinition,
+    transitionOverride?: MotionTransition,
+  ): Promise<void>;
+  set(definition: MotionDefinition): void;
+  stop(): void;
+}
+
+/**
+ * Imperatively start animations on every Motion component that receives
+ * these controls as its `animate` prop. Variant labels propagate to their
+ * variant children like a declarative `animate` label.
+ *
+ * @public
+ */
+export interface MotionAnimationControls {
+  /**
+   * Animate every bound component to `definition`. Resolves once the bound
+   * components and their variant children have finished.
+   */
+  start(
+    definition: MotionDefinition,
+    transitionOverride?: MotionTransition,
+  ): Promise<void>;
+  /** Jump every bound component to `definition` without animating. */
+  set(definition: MotionDefinition): void;
+  /** Stop the animations started by these controls. */
+  stop(): void;
+}
+
+class AnimationControls implements MotionAnimationControls {
+  private readonly subscribers = new Set<AnimationControlsSubscriber>();
+
+  subscribe(subscriber: AnimationControlsSubscriber): () => void {
+    this.subscribers.add(subscriber);
+    return () => this.subscribers.delete(subscriber);
+  }
+
+  start(
+    definition: MotionDefinition,
+    transitionOverride?: MotionTransition,
+  ): Promise<void> {
+    return Promise.all(
+      [...this.subscribers].map(subscriber =>
+        subscriber.start(definition, transitionOverride)
+      ),
+    ).then(() => undefined);
+  }
+
+  set(definition: MotionDefinition): void {
+    for (const subscriber of this.subscribers) {
+      subscriber.set(definition);
+    }
+  }
+
+  stop(): void {
+    for (const subscriber of this.subscribers) {
+      subscriber.stop();
+    }
+  }
+}
+
+/** @internal */
+export function isAnimationControls(
+  value: unknown,
+): value is AnimationControls {
+  return value instanceof AnimationControls;
+}
+
+/**
+ * Create animation controls outside React.
+ *
+ * @public
+ */
+export function animationControls(): MotionAnimationControls {
+  return new AnimationControls();
+}
+
+/**
+ * Create animation controls for `animate={controls}`.
+ *
+ * @public
+ */
+export function useAnimationControls(): MotionAnimationControls {
+  const controls = useMemo(() => new AnimationControls(), []);
+  useEffect(() => () => controls.stop(), [controls]);
+  return controls;
+}
+
+/**
+ * Alias of {@link useAnimationControls}.
+ *
+ * @public
+ */
+export const useAnimation: () => MotionAnimationControls = useAnimationControls;
