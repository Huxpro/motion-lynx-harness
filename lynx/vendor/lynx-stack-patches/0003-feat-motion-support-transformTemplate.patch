@@ -0,0 +1,134 @@
+// Copyright 2026 The Lynx Authors. All rights reserved.
+// Licensed under the Apache License Version 2.0 that can be found in the
+// LICENSE file in the root directory of this source tree.
+
+import type { MotionTransformTemplate } from './types.js';
+
+/**
+ * `transformTemplate` runs for every rendered frame, which happens on the main
+ * thread, while consumer closures live in the background runtime.
+ *
+ * - A Main Thread Function (`'main thread'` directive) is called directly on
+ *   the main thread with Motion's latest transform values.
+ * - A plain closure is compiled in the background: it is invoked once with
+ *   placeholder values, and the returned string becomes a list of literal
+ *   parts and value slots that the main thread fills in each frame. This is
+ *   exact for templates that compose values into a string, which is how
+ *   Motion documents the API; templates that branch on or compute with the
+ *   values need the `'main thread'` directive.
+ */
+export type CompiledTransformTemplate =
+  | { parts: (string | { key: string })[] }
+  | { worklet: MotionTransformTemplate };
+
+const SLOT_START = '\u0002';
+const SLOT_END = '\u0003';
+const GENERATED_SLOT = '';
+
+function isMainThreadFunction(value: unknown): boolean {
+  return typeof value === 'object'
+    && value !== null
+    && typeof (value as { _wkltId?: unknown })._wkltId === 'string';
+}
+
+function slot(key: string): string {
+  return `${SLOT_START}${key}${SLOT_END}`;
+}
+
+function fill(
+  parts: (string | { key: string })[],
+  transform: Readonly<Record<string, string>>,
+  generated: string,
+): string {
+  let output = '';
+  for (const part of parts) {
+    output += typeof part === 'string'
+      ? part
+      : (part.key === GENERATED_SLOT
+        ? generated
+        : String(transform[part.key]));
+  }
+  return output;
+}
+
+/**
+ * Compile a consumer template for the main thread.
+ *
+ * @param template - The consumer `transformTemplate`.
+ * @param sampleTransform - Real transform values used to check that the
+ *   compiled template reproduces the consumer function.
+ * @param sampleGenerated - Motion's generated transform for those values.
+ * @internal
+ */
+export function compileTransformTemplate(
+  template: MotionTransformTemplate | undefined,
+  sampleTransform: Readonly<Record<string, string>>,
+  sampleGenerated: string,
+): CompiledTransformTemplate | undefined {
+  if (template === undefined) {
+    return undefined;
+  }
+  if (isMainThreadFunction(template)) {
+    return { worklet: template };
+  }
+  if (typeof template !== 'function') {
+    return undefined;
+  }
+  const probe = new Proxy({} as Record<string, string>, {
+    get: (_target, key) => typeof key === 'string' ? slot(key) : undefined,
+  });
+  let probed: unknown;
+  try {
+    probed = template(probe, slot(GENERATED_SLOT));
+  } catch {
+    probed = undefined;
+  }
+  const parts: (string | { key: string })[] = [];
+  if (typeof probed === 'string') {
+    let cursor = 0;
+    while (cursor < probed.length) {
+      const start = probed.indexOf(SLOT_START, cursor);
+      if (start === -1) {
+        parts.push(probed.slice(cursor));
+        break;
+      }
+      const end = probed.indexOf(SLOT_END, start);
+      if (end === -1) {
+        break;
+      }
+      if (start > cursor) {
+        parts.push(probed.slice(cursor, start));
+      }
+      parts.push({ key: probed.slice(start + 1, end) });
+      cursor = end + 1;
+    }
+  }
+  const compiled = { parts };
+  if (
+    typeof probed !== 'string'
+    || fill(parts, sampleTransform, sampleGenerated)
+      !== template(sampleTransform, sampleGenerated)
+  ) {
+    console.warn(
+      '[@lynx-js/motion] transformTemplate must compose transform values into a string to run from the background runtime. Add the \'main thread\' directive to templates that compute with or branch on their values.',
+    );
+  }
+  return compiled;
+}
+
+/**
+ * Evaluate a compiled template on the main thread. `generated` is Motion's
+ * transform string, or `'none'` when every transform is at its default.
+ *
+ * @internal
+ */
+export function applyTransformTemplate(
+  template: CompiledTransformTemplate,
+  transform: Readonly<Record<string, string>>,
+  generated: string,
+): string {
+  const generatedTransform = generated === 'none' ? '' : generated;
+  return 'worklet' in template
+    ? template.worklet(transform, generatedTransform)
+    : fill(template.parts, transform, generatedTransform);
+}
